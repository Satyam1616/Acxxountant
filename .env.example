# The app runs fully offline with the local JSON adapter by default.
# Set this to "postgres" for a durable shared database deployment.
STORAGE_ADAPTER=json
# Set to true only for a disposable demo. Production should use Postgres.
ALLOW_EPHEMERAL_STORAGE=false
NEXT_PUBLIC_APP_NAME=LedgerFlow
APP_URL=http://localhost:3000

# Fresh demo workspaces default to INR (₹), en-IN number/date presentation,
# and the Asia/Kolkata timezone. Existing persisted workspaces keep their
# configured currency and timezone until an explicit settings change.

# Local development defaults to admin@ledgerflow.local / demo when these are empty.
# Production must set all three values to non-default secrets.
AUTH_SECRET=
APP_AUTH_EMAIL=
APP_AUTH_PASSWORD=
APP_AUTH_ROLE=admin
# Optional multi-user JSON. When set, it replaces the single APP_AUTH_* account:
# APP_AUTH_USERS=[{"email":"owner@example.com","password":"...","role":"admin"},{"email":"books@example.com","password":"...","role":"accountant"}]

# Optional provider settings. AI suggestions remain deterministic without them.
AI_PROVIDER=rules
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Production identity/integration placeholders.
DATABASE_URL=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
ENCRYPTION_KEY=

# Optional bank/accounting connections. Sandbox credentials are sufficient for development.
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_REDIRECT_URI=
QUICKBOOKS_ENV=sandbox
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=http://localhost:3000/api/integrations/quickbooks/callback
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://localhost:3000/api/integrations/xero/callback
